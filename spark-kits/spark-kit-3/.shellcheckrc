# ShellCheck configuration for DGX Spark LLM Stack
# https://www.shellcheck.net/wiki/Configuration
#
# Kept strict on purpose: the two historical bugs in earlier kits
# (readonly UID assignment, comments inside line continuations) and the
# truncated-command bug are all in the class of issues shellcheck flags.
# Do not widen these exclusions without a written justification here.

# SC1090: can't follow non-constant source (we source env files at runtime)
exclude=SC1090

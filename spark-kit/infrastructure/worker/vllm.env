# vllm.env - Environment variables for the vLLM worker node
# This file is automatically generated by deploy.sh.

VLLM_API_KEY=<generate-with-openssl-rand-hex-32>
DATABASE_URL=postgresql://litellm:<hub-db-password>@localhost:5432/litellm
LITELLM_MASTER_KEY=<master-key-from-hub>
APP_HOST=<hub-lan-ip>
APP_PORT=8000
